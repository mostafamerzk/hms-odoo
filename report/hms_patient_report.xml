<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- report action -->
        <record id="action_report_hms_patient" model="ir.actions.report">
            <field name="name">Patient Status Report</field>
            <field name="model">hms.patient</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hms.report_patient_status_template</field>
            <field name="report_file">hms.report_patient_status_template</field>
            <field name="print_report_name">'Patient Report - %s' % (object.first_name + ' ' + object.last_name)</field>
            <field name="binding_model_id" ref="model_hms_patient"/>
            <field name="binding_type">report</field>
        </record>

        <!-- report template -->
        <template id="report_patient_status_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: Arial, sans-serif;">
                            <div class="row mb-4">
                                <div class="col-8">
                                    <h1 style="color: #ff4d4d; font-size: 36px; font-weight: bold;">Patient Status Report</h1>
                                </div>
                                <div class="col-4 text-end">
                                    <img t-if="o.image" t-att-src="image_data_uri(o.image)" style="max-height: 120px; border: 1px solid #ddd;"/>
                                </div>
                            </div>

                            <div class="row mt-4" style="font-size: 16px;">
                                <div class="col-6">
                                    <p><strong>Name:</strong> <span t-field="o.first_name"/> <span t-field="o.last_name"/></p>
                                    <p><strong>Age:</strong> <span t-field="o.age"/></p>
                                    <p><strong>Department:</strong> <span t-field="o.department_id.name"/></p>
                                    <p><strong>Doctors:</strong> <span t-esc="', '.join(o.doctor_ids.mapped('first_name'))"/></p>
                                </div>
                                <div class="col-6">
                                    <p><strong>Birth date:</strong> <span t-field="o.birth_date"/></p>
                                    <p><strong>PCR:</strong> <span t-field="o.pcr"/></p>
                                    <p><strong>Blood Type:</strong> <span t-field="o.blood_type"/></p>
                                    <p><strong>Email:</strong> <span t-field="o.email"/></p>
                                </div>
                            </div>

                            <div class="mt-5">
                                <h3 class="text-center" style="color: #ff4d4d; margin-bottom: 0;">Log History</h3>
                                <table class="table table-bordered mt-2" style="border-collapse: collapse; width: 100%;">
                                    <thead style="background-color: #007bff; color: white;">
                                        <tr>
                                            <th style="padding: 10px;">User</th>
                                            <th style="padding: 10px;">Date</th>
                                            <th style="padding: 10px;">Info</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.log_ids" t-as="log" style="background-color: #e6f2ff;">
                                            <td style="padding: 10px;"><span t-field="log.created_by.name"/></td>
                                            <td style="padding: 10px;"><span t-field="log.date"/></td>
                                            <td style="padding: 10px;"><span t-field="log.description"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
