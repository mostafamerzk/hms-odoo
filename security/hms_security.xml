<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- module category -->
        <record id="module_category_hms" model="ir.module.category">
            <field name="name">HMS</field>
            <field name="description">Hospital Management System Access</field>
            <field name="sequence">10</field>
        </record>

        <!-- privilege -->
        <record id="hms_privilege" model="res.groups.privilege">
            <field name="name">Hospital Management Access</field>
            <field name="category_id" ref="module_category_hms"/>
        </record>

        <!-- groups -->
        <record id="hms_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="hms_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="hms_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="hms_privilege"/>
            <field name="implied_ids" eval="[(4, ref('hms_group_user'))]"/>
            <!-- Manager gets all permissions -->
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- record rules -->
        <record id="rule_patient_user_own" model="ir.rule">
            <field name="name">User: Own Patients Only</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hms_group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_patient_manager_all" model="ir.rule">
            <field name="name">Manager: All Patients</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hms_group_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
