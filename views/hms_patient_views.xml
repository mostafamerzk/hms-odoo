<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- list view -->
        <record id="view_hms_patient_list" model="ir.ui.view">
            <field name="name">hms.patient.list</field>
            <field name="model">hms.patient</field>
            <field name="arch" type="xml">
                <list string="Patients">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="blood_type"/>
                    <field name="pcr"/>
                    <field name="birth_date"/>
                    <field name="department_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- form view -->
        <record id="view_hms_patient_form" model="ir.ui.view">
            <field name="name">hms.patient.form</field>
            <field name="model">hms.patient</field>
            <field name="arch" type="xml">
                <form string="Patient">
                    <header>
                        <!-- state bar -->
                        <field name="state" widget="statusbar"
                               statusbar_visible="undetermined,good,fair,serious"/>
                    </header>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>

                        <group>
                            <group string="personal information">
                                <field name="first_name"/>
                                <field name="last_name"/>
                                <field name="email"/>
                                <field name="birth_date"/>
                                <field name="age" readonly="1"/>
                                <field name="address"/>
                            </group>
                            <group string="medical information">
                                <field name="blood_type"/>
                                <!-- cr_ratio required when pcr checked -->
                                <field name="cr_ratio" required="pcr"/>
                                <field name="pcr"/>
                            </group>
                        </group>

                        <group>
                            <group string="department">
                                <field name="department_id"/>
                                <!-- capacity read-only from dept -->
                                <field name="department_capacity" readonly="1"/>
                            </group>
                            <group string="doctors">
                                <!-- readonly until dept selected -->
                                <field name="doctor_ids"
                                       widget="many2many_tags"
                                       readonly="not department_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Medical History" name="history_page"
                                  invisible="age &lt; 50">
                                <field name="history" placeholder="medical history"/>
                            </page>
                            <page string="Log History" name="log_page">
                                <field name="log_ids">
                                    <list editable="bottom">
                                        <field name="created_by"/>
                                        <field name="date"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- action -->
        <record id="action_hms_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">hms.patient</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- access: patient -->
        <record id="access_hms_patient_user" model="ir.model.access">
            <field name="name">hms.patient.user</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- access: patient log -->
        <record id="access_hms_patient_log_user" model="ir.model.access">
            <field name="name">hms.patient.log.user</field>
            <field name="model_id" ref="model_hms_patient_log"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
