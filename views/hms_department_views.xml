<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- list view -->
        <record id="view_hms_department_list" model="ir.ui.view">
            <field name="name">hms.department.list</field>
            <field name="model">hms.department</field>
            <field name="arch" type="xml">
                <list string="Departments">
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="is_opened"/>
                </list>
            </field>
        </record>

        <!-- form view -->
        <record id="view_hms_department_form" model="ir.ui.view">
            <field name="name">hms.department.form</field>
            <field name="model">hms.department</field>
            <field name="arch" type="xml">
                <form string="Department">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="capacity"/>
                            <field name="is_opened"/>
                        </group>
                        <notebook>
                            <page string="Patients" name="patients_page">
                                <!-- patients in dept -->
                                <field name="patient_ids">
                                    <list>
                                        <field name="first_name"/>
                                        <field name="last_name"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- action -->
        <record id="action_hms_department" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">hms.department</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- access: department -->
        <record id="access_hms_department_user" model="ir.model.access">
            <field name="name">hms.department.user</field>
            <field name="model_id" ref="model_hms_department"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
